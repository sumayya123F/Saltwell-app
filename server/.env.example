# TheMealDB base URL (no trailing slash, no key)
MEALDB_API_BASE=https://www.themealdb.com/api/json/v1
# "1" is the public development key. Use your own key in production.
MEALDB_API_KEY=1
PORT=3001
# Comma-separated list of allowed browser origins in production (dev uses the Vite proxy)
CORS_ORIGIN=http://localhost:5173
